# Для запуска приложения вне Docker (cp .env.example .env).
# docker compose берёт значения из docker-compose.yml и .env не требует.
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_KEY=dev-api-key
LOG_LEVEL=INFO

# --- необязательные параметры (значения по умолчанию) ---
# OUTBOX_POLL_INTERVAL=0.5      # пауза между опросами outbox, сек
# OUTBOX_BATCH_SIZE=100
# GATEWAY_MIN_DELAY=2           # эмуляция шлюза: задержка, сек
# GATEWAY_MAX_DELAY=5
# GATEWAY_SUCCESS_RATE=0.9
# WEBHOOK_TIMEOUT=10
# MAX_ATTEMPTS=3                # попыток обработки/доставки до DLQ
# RETRY_BASE_DELAY=1            # пауза между попытками: 1 с, 2 с, 4 с, ...
# CONSUMER_CONCURRENCY=20
